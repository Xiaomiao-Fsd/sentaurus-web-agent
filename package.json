{
  "name": "sentaurus-web-agent",
  "version": "0.6.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "description": "Browser dashboard/chat for a Sentaurus TCAD agent bridge.",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run dev -w @sentaurus-agent/server\" \"npm run dev -w @sentaurus-agent/web\"",
    "start:dev": "npm run dev",
    "dev:ensure": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/web-dev-watchdog.ps1 -Mode ensure",
    "dev:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/web-dev-watchdog.ps1 -Mode status",
    "dev:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/web-dev-watchdog.ps1 -Mode stop",
    "dev:web": "npm run dev -w @sentaurus-agent/web",
    "dev:server": "npm run dev -w @sentaurus-agent/server",
    "migrate:runs:dry-run": "node scripts/migrate-local-runs.mjs",
    "migrate:runs": "node scripts/migrate-local-runs.mjs --apply",
    "test:session-history": "node --import tsx --import ./apps/server/test/setup.ts --test apps/server/test/sessionHistory.test.ts apps/web/test/sessionHistoryState.test.ts apps/web/test/vmSessionFilesState.test.ts",
    "test:plt-extraction": "node --import tsx --import ./apps/server/test/setup.ts --test apps/server/test/dfiseIdvgExtract.test.ts apps/server/test/pltIntegration.test.ts apps/web/test/vmSessionFilesState.test.ts",
    "test:codex-features": "node --import tsx --import ./apps/server/test/codexFeaturesSetup.ts --test apps/server/test/vmAgentInstructions.test.ts apps/server/test/vmWorkerCommands.test.ts apps/web/test/slashCommands.test.ts",
    "build": "npm run build -w @sentaurus-agent/shared && npm run build -w @sentaurus-agent/server && npm run build -w @sentaurus-agent/web",
    "typecheck": "npm run build -w @sentaurus-agent/shared && npm run typecheck -w @sentaurus-agent/server && npm run typecheck -w @sentaurus-agent/web && npm run typecheck -w @sentaurus-agent/shared",
    "check": "npm run typecheck",
    "verify": "npm run typecheck && npm run build",
    "lint": "npm run lint --workspaces --if-present",
    "prepare:shared": "npm run build -w @sentaurus-agent/shared"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "typescript": "^5.8.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
