# Server
PORT=5175
HOST=::1
CORS_ORIGIN=http://[::1]:5174
AUTH_TOKEN=replace-with-a-random-token-at-least-24-characters

# Host-side LLM values are not needed for the VM Agent panel.
# Put real VM agent credentials inside the CentOS VM instead:
# ~/.sentaurus-web-agent/vm-agent/.env
# LLM_API_BASE=https://example.com/v1
# LLM_API_KEY=replace-me-locally
# LLM_MODEL=gpt-5.5
# LLM_API_STYLE=chat-completions

# Sentaurus VM SSH bridge.
# On the Windows host, create an OpenSSH alias named sentaurus-centos7,
# or set this to a direct ssh target such as TCAD2022@192.168.134.132.
SENTAURUS_SSH_TARGET=sentaurus-centos7
SENTAURUS_REMOTE_BASE=/home/TCAD2022/STDB/web-agent-runs
LOCAL_RUN_BASE=./data/runs
VM_AGENT_HISTORY_TIMEOUT_MS=45000
VM_AGENT_HISTORY_MAX_RESPONSE_BYTES=4194304
MAX_UPLOAD_MB=200

# Safety: keep 0 until you are ready to let the web backend start real SDE/SDevice jobs.
ENABLE_REAL_JOBS=0
